# Copy to .env and fill in. Never commit the real .env.

# Server
PORT=8787
APP_URL=http://localhost:8787
# Secret used to sign auth tokens: at least 32 random characters, e.g. `openssl rand -hex 32`.
# The server refuses to start with NODE_ENV=production if this is missing or a placeholder.
JWT_SECRET=change-me-to-a-long-random-string

# Browser origins allowed to call the API (comma-separated). Unset: any origin in dev, APP_URL in production.
CORS_ORIGINS=
# Set to 1 only when running behind a reverse proxy you control (trust X-Forwarded-For).
TRUST_PROXY=0

# Which provider/model the managed service uses for all users.
# provider: anthropic | openai | xai
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5

# Provider API keys — only the one matching AI_PROVIDER is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Stripe (test mode is fine to start). Leave blank to disable billing endpoints.
STRIPE_SECRET_KEY=
# The recurring Price you created in the Stripe dashboard for the Pro plan.
STRIPE_PRICE_ID=
# From the Stripe CLI or dashboard webhook settings.
STRIPE_WEBHOOK_SECRET=

# AI uses (grades, review replies, AI prompts) included per plan. Every plan is capped:
# whole numbers >= 0 only (-1 / "unlimited" is rejected). Placeholder values; tune to your costs.
FREE_MONTHLY_LIMIT=10
FREE_DAILY_LIMIT=10
PRO_MONTHLY_LIMIT=300
PRO_DAILY_LIMIT=50

# Per-minute request limits (per server instance). 0 disables.
AUTH_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=20
# Per client IP on AI routes, across all accounts.
AI_IP_RATE_LIMIT_PER_MINUTE=60
