# Copy to .env and fill in. Never commit the real .env.

# Server
PORT=8787
APP_URL=http://localhost:8787
# Secret used to sign auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Which provider/model the managed service uses for all users.
# provider: anthropic | openai | xai
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5

# Provider API keys — only the one matching AI_PROVIDER is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Stripe (test mode is fine to start). Leave blank to disable billing endpoints.
STRIPE_SECRET_KEY=
# The recurring Price you created in the Stripe dashboard for the Pro plan.
STRIPE_PRICE_ID=
# From the Stripe CLI or dashboard webhook settings.
STRIPE_WEBHOOK_SECRET=

# Monthly included feedback requests per plan.
FREE_MONTHLY_LIMIT=10
PRO_MONTHLY_LIMIT=-1
